#!/bin/bash

# Helpers for the omaudiopanel audio panel: disabling audio devices and routing
# individual application streams to a specific output.
#
#   omaudiopanel list-disabled                    name<TAB>kind<TAB>label<TAB>card<TAB>part
#   omaudiopanel disable <node-name> <sink|source> <label>
#   omaudiopanel enable <node-name>
#   omaudiopanel list-streams                     id<TAB>current<TAB>routed<TAB>app<TAB>paused(0|1)
#   omaudiopanel list-pins                        app<TAB>sink-name<TAB>sink-label
#   omaudiopanel pin <app> <sink-name> <label> [stream-id]
#                                                 always play <app> on that output
#   omaudiopanel unpin <app>
#   omaudiopanel apply-pins                       route new streams of pinned apps
#   omaudiopanel route <stream-id> <sink-name>
#   omaudiopanel unroute <stream-id>
#   omaudiopanel set-default-sink <node-id> <sink-name>
#   omaudiopanel volume <up|down>                 step by the panel's scrollStep
#
# Disabling switches the device's card to the profile without that output or
# input (e.g. output:analog-stereo+input:mono-fallback -> output:analog-stereo),
# or to "off" when nothing else is left. Only that card changes, so other
# devices keep playing, and WirePlumber restores the chosen profile after a
# reboot. Routing sets target.object in the default metadata, which
# WirePlumber follows; when that output is missing it falls back to the
# default and relinks once the output returns. A pin applies that route to
# every stream of an app that was not routed by hand.

set -u

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omaudiopanel
state_file=$state_dir/disabled-nodes
pins_file=$state_dir/pins
# A route a pin creates carries this metadata key, valued "app|sink" (sink
# names never contain "|"). PipeWire drops a stream's metadata when the stream
# goes away, so the marker can never outlive its stream or attach to a reused
# id. A route set by hand clears the marker; unpin undoes only marked routes.
pin_marker=omaudiopanel.pin
# Commands that change routes or pins take this lock, so the two panel
# instances and back-to-back clicks cannot interleave their reads and writes.
lock_file=${XDG_RUNTIME_DIR:-$state_dir}/omaudiopanel.lock
shell_config=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json

usage() {
  sed -n '6,18p' "$0" | sed 's/^# \{0,3\}//' >&2
  exit 1
}

remove_entry() {
  local target=$1
  [[ -f $state_file ]] || return 0
  awk -F'\t' -v n="$target" '$1 != n' "$state_file" >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"
}

# Pick an available profile on a card. $2 is a JSON array of profile parts
# ("output:analog-stereo", "input:mono-fallback") the result should have;
# $3 is a part that must be included, or "" for none. Prefers an exact match,
# then the highest-priority profile using only wanted parts (and the required
# one), and falls back to "off".
choose_profile() {
  local card_json=$1 want=$2 need=$3
  jq -r --argjson want "$want" --arg need "$need" '
    [.profiles | to_entries[]
      | select(.value.available and .key != "off" and .key != "pro-audio")
      | {name: .key, prio: .value.priority, parts: (.key | split("+"))}] as $all
    | ($all | map(select((.parts | sort) == ($want | sort))) | .[0].name) //
      ($all
        | map(select((.parts - $want) == [] and ($need == "" or (.parts | index($need)))))
        | sort_by(-.prio) | .[0].name) //
      "off"' <<<"$card_json"
}

card_json() {
  timeout 2 pactl -f json list cards 2>/dev/null | jq -c --arg c "$1" '.[] | select(.name == $c)'
}

metadata_dump() {
  timeout 2 pw-metadata 2>/dev/null
}

# id<TAB>routed-sink for every stream with a target, from a metadata dump on
# stdin. WirePlumber writes -1 for "no specific target", which means the
# stream follows the default, so it is not a route.
parse_routes() {
  sed -n "s/^update: id:\([0-9]*\) key:'target\.object' value:'\([^']*\)'.*/\1\t\2/p" \
    | awk -F'\t' '$2 != "" && $2 != "-1"'
}

# id, app and sink for every pin marker, from a metadata dump on stdin,
# separated by \x1f: unlike a tab, it does not collapse the empty app field
# in bash's read.
# pw-metadata prints values unescaped, so the value runs to the last
# "' type:" (app names can contain an apostrophe). A marker from the previous
# version holds only the sink; its app is left empty for marker_app to fill.
parse_markers() {
  sed -n "s/^update: id:\([0-9]*\) key:'${pin_marker//./\\.}' value:'\(.*\)' type:.*/\1\t\2/p" \
    | awk -F'\t' '{
        n = split($2, part, "|"); sink = part[n]
        if (sink == "") next
        app = n < 2 ? "" : substr($2, 1, length($2) - length(sink) - 1)
        print $1 "\037" app "\037" sink
      }'
}

# Marker records for a dump. Old sink-only markers (empty app) need the app
# list from pactl; it is fetched here, once, outside any subshell, so
# marker_app can read it.
stream_app_list=""
load_markers() {
  markers=$(parse_markers <<<"$1")
  if grep -q $'^[0-9]*\x1f\x1f' <<<"$markers"; then
    stream_app_list=$(stream_apps)
  fi
}

# App of a marked stream: from the marker, or for an old sink-only marker,
# from the list load_markers fetched.
marker_app() {
  local id=$1 app=$2
  [[ -n $app ]] || app=$(value_of "$id" "$stream_app_list")
  printf '%s' "$app"
}

# Value for key $1 in a key<TAB>value list ($2), e.g. a stream's route or app.
value_of() {
  awk -F'\t' -v id="$1" '$1 == id { print $2; exit }' <<<"$2"
}

stream_routes() {
  metadata_dump | parse_routes
}

# Route a stream for a pin and mark it; the marker is written only once the
# route itself is set.
pin_route() {
  local id=$1 app=$2 sink=$3
  timeout 2 pw-metadata "$id" target.object "$sink" >/dev/null \
    && timeout 2 pw-metadata "$id" "$pin_marker" "$app|$sink" >/dev/null
}

# id<TAB>app for every application playback stream.
stream_apps() {
  timeout 2 pactl -f json list sink-inputs 2>/dev/null \
    | jq -r '.[] | select(.properties["object.id"] != null and .properties["application.name"] != null)
        | "\(.properties["object.id"])\t\(.properties["application.name"])"'
}

# Route new streams of pinned apps. The pinned output does not need to be
# plugged in: WirePlumber plays the stream on the default until it appears,
# then moves it there.
apply_pins() {
  [[ -s $pins_file ]] || return 0
  local routes id app pin
  routes=$(stream_routes)
  while IFS=$'\t' read -r id app; do
    pin=$(awk -F'\t' -v a="$app" '$1 == a { print $2; exit }' "$pins_file")
    [[ -n $pin && -z $(value_of "$id" "$routes") ]] || continue
    pin_route "$id" "$app" "$pin"
  done < <(stream_apps)
}

routed_stream_ids() {
  metadata_dump \
    | sed -n "s/^update: id:\([0-9]*\) key:'target\.\(object\|node\)' value:'\([^']*\)'.*/\1\t\3/p" \
    | awk -F'\t' '$2 != "" && $2 != "-1" { print $1 }' \
    | sort -u
}

cmd=${1:-}
shift || true

case $cmd in
  pin | unpin | apply-pins | route | unroute | set-default-sink)
    mkdir -p "$(dirname "$lock_file")"
    exec 9>"$lock_file"
    flock -w 30 9 || { echo "omaudiopanel: could not take $lock_file" >&2; exit 1; }
    ;;
esac

case $cmd in
  list-disabled)
    [[ -f $state_file ]] && cat "$state_file"
    exit 0
    ;;

  disable)
    name=${1:-} kind=${2:-} label=${3:-}
    [[ -n $name && ( $kind == sink || $kind == source ) ]] || usage
    label=${label//$'\t'/ }

    read -r card profile_name < <(timeout 2 pactl -f json list "${kind}s" 2>/dev/null \
      | jq -r --arg n "$name" '.[] | select(.name == $n)
          | "\(.properties["device.name"] // "") \(.properties["device.profile.name"] // "")"')
    [[ -n ${card:-} ]] || { echo "No card found for $name" >&2; exit 1; }
    json=$(card_json "$card")
    active=$(jq -r '.active_profile' <<<"$json")

    if [[ -n ${profile_name:-} ]]; then
      [[ $kind == sink ]] && part="output:$profile_name" || part="input:$profile_name"
      remaining=$(jq -cn --arg a "$active" --arg p "$part" '$a | split("+") | map(select(. != $p and . != "off"))')
      if [[ $remaining == "[]" ]]; then
        target=off
      else
        target=$(choose_profile "$json" "$remaining" "")
      fi
    else
      # Bluetooth: profiles are whole modes (a2dp-sink, headset-head-unit),
      # not output/input parts. Keep the other direction if some profile
      # offers it without this one, else turn the card off; remember the
      # active profile so enable can restore it exactly.
      part="profile:$active"
      [[ $kind == sink ]] && { drop=sinks; keep=sources; } || { drop=sources; keep=sinks; }
      target=$(jq -r --arg drop "$drop" --arg keep "$keep" --arg a "$active" '
        (.profiles[$a][$keep] // 0) as $had
        | if $had == 0 then "off" else
            ([.profiles | to_entries[]
              | select(.value.available and .value[$drop] == 0 and .value[$keep] > 0)]
             | sort_by(-.value.priority) | .[0].key) // "off"
          end' <<<"$json")
    fi

    timeout 2 pactl set-card-profile "$card" "$target" || exit 1
    mkdir -p "$state_dir"
    remove_entry "$name"
    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$kind" "${label:-$name}" "$card" "$part" >>"$state_file"
    ;;

  enable)
    name=${1:-}
    [[ -n $name && -f $state_file ]] || usage
    IFS=$'\t' read -r _ _ _ card part < <(awk -F'\t' -v n="$name" '$1 == n' "$state_file")
    if [[ -n ${card:-} && ${part:-} == profile:* ]]; then
      timeout 2 pactl set-card-profile "$card" "${part#profile:}" || exit 1
    elif [[ -n ${card:-} && -n ${part:-} ]]; then
      json=$(card_json "$card")
      active=$(jq -r '.active_profile' <<<"$json")
      want=$(jq -cn --arg a "$active" --arg p "$part" '($a | split("+") | map(select(. != "off" and . != "pro-audio"))) + [$p] | unique')
      target=$(choose_profile "$json" "$want" "$part")
      timeout 2 pactl set-card-profile "$card" "$target" || exit 1
    fi
    remove_entry "$name"
    ;;

  volume)
    # Same step as the bar icon's scroll wheel, for the volume keys and any
    # hardware volume wheel that sends them.
    step=$(jq -r '[.. | objects | select(.id? == "videinfra.omaudiopanel") | .scrollStep? // empty][0] // 5' "$shell_config" 2>/dev/null)
    [[ $step =~ ^[0-9]+$ ]] || step=5
    case ${1:-} in
      up) exec omarchy-audio-output-volume "+$step" ;;
      down) exec omarchy-audio-output-volume "-$step" ;;
      *) usage ;;
    esac
    ;;

  list-streams)
    # Current sink comes from pactl rather than the shell's PipeWire link
    # tracking, which does not report links for stream nodes.
    routes=$(stream_routes)
    sinks=$(timeout 2 pactl -f json list sinks 2>/dev/null | jq -c 'map({(.index | tostring): .name}) | add // {}')
    [[ -n $sinks ]] || sinks='{}'
    timeout 2 pactl -f json list sink-inputs 2>/dev/null \
      | jq -r --argjson sinks "$sinks" '.[]
          | select(.properties["object.id"] != null)
          | [.properties["object.id"], ($sinks[.sink | tostring] // ""),
             (.properties["application.name"] // ""), (if .corked then "1" else "0" end)]
          | @tsv' \
      | while IFS=$'\t' read -r id current app paused; do
          routed=$(value_of "$id" "$routes")
          printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$current" "$routed" "$app" "$paused"
        done
    exit 0
    ;;

  list-pins)
    [[ -f $pins_file ]] && cat "$pins_file"
    exit 0
    ;;

  pin)
    # pin <app> <sink> <label> [stream-id]: stream-id is the stream the user is
    # looking at; it joins the pin even if it was routed by hand.
    app=${1:-} sink=${2:-} label=${3:-} stream=${4:-}
    [[ -n $app && -n $sink ]] || usage
    mkdir -p "$state_dir"
    [[ -f $pins_file ]] && awk -F'\t' -v a="$app" '$1 != a' "$pins_file" >"$pins_file.tmp" && mv "$pins_file.tmp" "$pins_file"
    printf '%s\t%s\t%s\n' "$app" "$sink" "${label:-$sink}" >>"$pins_file"
    # Re-pinning moves the pin's own routes (still on their marked output) to
    # the new output, plugged in or not; routes set by hand stay.
    dump=$(metadata_dump)
    routes=$(parse_routes <<<"$dump")
    load_markers "$dump"
    while IFS=$'\x1f' read -r id marked_app marked_sink; do
      [[ -n $id && $id != "$stream" && $marked_sink != "$sink" ]] || continue
      [[ $(marker_app "$id" "$marked_app") == "$app" ]] || continue
      [[ $(value_of "$id" "$routes") == "$marked_sink" ]] && pin_route "$id" "$app" "$sink"
    done <<<"$markers"
    [[ -n $stream ]] && pin_route "$stream" "$app" "$sink"
    apply_pins
    ;;

  unpin)
    # Works from the markers alone (they carry the app), so it needs neither
    # pactl nor the pins file, and running it again finishes a reset that
    # failed part way. Only old sink-only markers need pactl for their app.
    app=${1:-}
    [[ -n $app ]] || usage
    [[ -f $pins_file ]] && awk -F'\t' -v a="$app" '$1 != a' "$pins_file" >"$pins_file.tmp" && mv "$pins_file.tmp" "$pins_file"
    dump=$(metadata_dump)
    routes=$(parse_routes <<<"$dump")
    load_markers "$dump"
    while IFS=$'\x1f' read -r id marked_app marked_sink; do
      [[ -n $id && $(marker_app "$id" "$marked_app") == "$app" ]] || continue
      if [[ $(value_of "$id" "$routes") == "$marked_sink" ]]; then
        # Keep the marker if the reset fails, so a later unpin can retry.
        timeout 2 pw-metadata -d "$id" target.object >/dev/null || continue
        timeout 2 pw-metadata -d "$id" target.node >/dev/null
      fi
      timeout 2 pw-metadata -d "$id" "$pin_marker" >/dev/null
    done <<<"$markers"
    ;;

  apply-pins)
    apply_pins
    ;;

  route)
    id=${1:-} sink=${2:-}
    [[ -n $id && -n $sink ]] || usage
    # A route set by hand is not the pin's, so it drops the marker, but only
    # once the new route is really in place.
    timeout 2 pw-metadata "$id" target.object "$sink" >/dev/null \
      && timeout 2 pw-metadata -d "$id" "$pin_marker" >/dev/null
    ;;

  unroute)
    id=${1:-}
    [[ -n $id ]] || usage
    timeout 2 pw-metadata -d "$id" target.object >/dev/null
    timeout 2 pw-metadata -d "$id" target.node >/dev/null
    timeout 2 pw-metadata -d "$id" "$pin_marker" >/dev/null
    ;;

  set-default-sink)
    # Same as omarchy-audio-output-set-default, except streams routed to a
    # specific output from this panel are left where they are.
    node_id=${1:-} sink_name=${2:-}
    [[ -n $node_id && -n $sink_name ]] || usage

    timeout 2 wpctl set-default "$node_id" 2>/dev/null || true
    timeout 2 pactl set-default-sink "$sink_name" 2>/dev/null || true

    routed=" $(routed_stream_ids | tr '\n' ' ') "

    timeout 2 pactl -f json list sink-inputs 2>/dev/null \
      | jq -r '.[]
          | select(.properties["application.name"] != null
                   and .properties["application.name"] != "EasyEffects")
          | "\(.index)\t\(.properties["object.id"] // "")"' \
      | while IFS=$'\t' read -r index object_id; do
          [[ -z $index ]] && continue
          [[ -n $object_id && $routed == *" $object_id "* ]] && continue
          timeout 2 pactl move-sink-input "$index" "$sink_name" 2>/dev/null || true
        done
    ;;

  *)
    usage
    ;;
esac
