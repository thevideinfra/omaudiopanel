{
  "schemaVersion": 1,
  "id": "videinfra.omaudiopanel",
  "name": "omaudiopanel",
  "version": "0.3.1",
  "author": "thevideinfra",
  "license": "MIT",
  "description": "Omarchy's audio panel plus device disabling, per-app output routing and pinning, tab titles and an adjustable volume step",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "omaudiopanel",
    "description": "Volume, outputs and inputs you can disable, a per-app mixer with output routing and pins, and an adjustable volume step",
    "category": "Audio",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "scrollStep": 5,
      "density": "normal",
      "showPlayingBars": true,
      "showRouting": true,
      "showDisabled": true,
      "showStepFooter": true,
      "fontSize": "normal",
      "showSectionMutes": true
    },
    "schema": [
      {
        "key": "density",
        "type": "enum",
        "label": "Density",
        "options": [
          "compact",
          "normal",
          "comfortable"
        ],
        "defaultValue": "normal",
        "description": "How tightly the panel is laid out."
      },
      {
        "key": "fontSize",
        "type": "enum",
        "label": "Font size",
        "options": [
          "small",
          "normal",
          "large"
        ],
        "defaultValue": "normal",
        "description": "Text size, on top of the density's own scaling."
      },
      {
        "key": "scrollStep",
        "type": "integer",
        "label": "Volume step (%)",
        "min": 1,
        "max": 25,
        "step": 1,
        "defaultValue": 5,
        "description": "Per scroll notch, slider step, h/l in the panel and (with the optional binding) the volume keys."
      },
      {
        "key": "showPlayingBars",
        "type": "boolean",
        "label": "Show playing bars",
        "defaultValue": true
      },
      {
        "key": "showSectionMutes",
        "type": "boolean",
        "label": "Show output and input mute switches",
        "defaultValue": true
      },
      {
        "key": "showRouting",
        "type": "boolean",
        "label": "Show the output field under each app",
        "defaultValue": true
      },
      {
        "key": "showDisabled",
        "type": "boolean",
        "label": "Show the Disabled devices section",
        "defaultValue": true
      },
      {
        "key": "showStepFooter",
        "type": "boolean",
        "label": "Show the volume step footer",
        "defaultValue": true
      }
    ]
  },
  "omarchy": {
    "clonedFrom": "omarchy.audio"
  }
}
